# Copia este archivo a ".env" y ajusta los valores. NUNCA subas el .env real a GitHub.
POSTGRES_USER=securescan
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=securescan
SECRET_KEY=genera-una-clave-larga-y-aleatoria
# Escaneo de direcciones públicas: dejar en false salvo autorización escrita del dueño del sistema.
ALLOW_PUBLIC_SCANS=false
# Clave de la API de OWASP ZAP (la usan el backend y el contenedor zap).
ZAP_API_KEY=genera-otra-clave-larga-y-aleatoria
